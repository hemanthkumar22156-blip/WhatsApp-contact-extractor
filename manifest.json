{
  "manifest_version": 3,
  "name": "WhatsApp Group Contact Extractor",
  "version": "1.0.0",
  "description": "Extract visible WhatsApp Web group contacts and export them as CSV.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Contact Extractor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
